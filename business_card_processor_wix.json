    },
    {
      "parameters": {
        "jsCode": "const binaryData = $input.first().binary.data;\nconst base64 = binaryData.data;\nconst mimeType = binaryData.mimeType || 'image/jpeg';\n\nconst formData = $('Wix Webhook').first().json;\n\nreturn [{\n  json: {\n    image_base64: `data:${mimeType};base64,${base64}`,\n    event_name: formData['Event Name'] || '',\n    event_date: formData['Event Date'] || '',\n    your_notes: formData['Your Notes'] || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "id": "convert-base64-001",
      "name": "Convert to Base64"
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "text": "Extract all contact information from this business card image. Return ONLY valid JSON with no additional text or markdown.\n\nRequired JSON format:\n{\n  \"first_name\": \"\",\n  \"last_name\": \"\",\n  \"email\": \"\",\n  \"phone\": \"\",\n  \"company\": \"\",\n  \"title\": \"\",\n  \"address\": \"\",\n  \"website\": \"\",\n  \"linkedin\": \"\",\n  \"other_social\": \"\",\n  \"card_notes\": \"\"\n}\n\nRules:\n- Extract exactly what is visible on the card\n- If a field is not present, use empty string\n- For card_notes, include any handwritten text visible on the card\n- Do not guess or fabricate information\n- Return ONLY the JSON object, no explanation",
        "inputType": "base64",
        "binaryPropertyName": "={{ $json.image_base64 }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [720, 0],
      "id": "extract-card-001",
      "name": "Extract Card Info",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawContent = $input.first().json.content;\n\nlet cleanJson = rawContent;\nif (typeof cleanJson === 'string') {\n  cleanJson = cleanJson.replace(/```json\\n?/gi, '').replace(/```\\n?/gi, '').trim();\n}\n\ntry {\n  const parsed = typeof cleanJson === 'string' ? JSON.parse(cleanJson) : cleanJson;\n  \n  const formData = $('Convert to Base64').first().json;\n  \n  return [{\n    json: {\n      first_name: parsed.first_name || '',\n      last_name: parsed.last_name || '',\n      email: parsed.email || '',\n      phone: parsed.phone || '',\n      company: parsed.company || '',\n      title: parsed.title || '',\n      address: parsed.address || '',\n      website: parsed.website || '',\n      linkedin: parsed.linkedin || '',\n      other_social: parsed.other_social || '',\n      card_notes: parsed.card_notes || '',\n      your_notes: formData.your_notes || '',\n      event_name: formData.event_name || '',\n      event_date: formData.event_date || '',\n      date_added: new Date().toISOString().split('T')[0],\n      email_sent: 'No',\n      date_contacted: ''\n    }\n  }];\n} catch (err) {\n  throw new Error('Failed to parse card data: ' + err.message);\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "id": "parse-data-001",
      "name": "Parse Card Data"
    },
    {
      "parameters": {
