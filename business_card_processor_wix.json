      "typeVersion": 4.5,
      "position": [1200, 0],
      "id": "get-template-001",
      "name": "Get Email Template",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const contact = $('Parse Card Data').first().json;\nconst template = $input.first().json;\n\nlet subject = template['Subject Line'] || 'Great connecting!';\nlet body = template['Email Body'] || 'Hi {{first_name}},\\n\\nGreat meeting you!\\n\\nBest regards';\n\nconst replacements = {\n  '{{first_name}}': contact.first_name,\n  '{{last_name}}': contact.last_name,\n  '{{company}}': contact.company,\n  '{{title}}': contact.title,\n  '{{event_name}}': contact.event_name,\n  '{{event_date}}': contact.event_date,\n  '{{your_signature}}': '[YOUR SIGNATURE]',\n  '{{custom_paragraph}}': contact.your_notes ? `I particularly enjoyed discussing ${contact.your_notes}.` : 'I look forward to exploring how we might collaborate.'\n};\n\nfor (const [key, value] of Object.entries(replacements)) {\n  subject = subject.replace(new RegExp(key.replace(/[{}]/g, '\\\\$&'), 'gi'), value || '');\n  body = body.replace(new RegExp(key.replace(/[{}]/g, '\\\\$&'), 'gi'), value || '');\n}\n\nreturn [{\n  json: {\n    ...contact,\n    email_subject: subject,\n    email_body: body\n  }\n}];"
      },
